{
  "name": "carlos",
  "version": "0.0.0",
  "private": true,
  "description": "Carlos, the Alliance Attendant: the Discord bot for one alliance's sheets in Last Asylum: Plague",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
