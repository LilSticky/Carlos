# Copy to .env (local) or set in the Wispbyte panel. Never commit real values.

# Discord developer portal > your application
DISCORD_TOKEN=
DISCORD_APP_ID=
# The alliance's Discord server, and the channel where members post their screenshots
GUILD_ID=
UPLOAD_CHANNEL_ID=

# The same text as the BOT_SECRET script property of every sheet's web app
SHEET_SECRET=

# Where the SQLite file goes (default: data)
DATA_DIR=data

# The /exec link of Alliance Members' web app (Bot.js): the member list, and the screenshots and recordings
# members post in Discord. Required.
MEMBERS_URL=https://script.google.com/macros/s/.../exec

# Optional: the /exec links of the other sheets' web apps (Bot.js). A sheet without a link has no commands.
COACHMAN_URL=
EVENTS_URL=
KVK_URL=
STATS_URL=
SIEGE_URL=
# Optional: the announcement channel for the invitation cards (Undead Siege, KvK vote), /lead post and the siege
# plan and KvK Readiness card. Invitations and announcements tag @here. Default: the alliance's announcement channel.
ANNOUNCE_CHANNEL_ID=
# Optional: the channel where R4 and R5 post screen recordings of event rankings (the video inbox). Carlos sends
# each video to the Upload Inbox as a recording, asking which ranking it shows when the post does not say.
VIDEO_CHANNEL_ID=
# Optional: a forum channel where Carlos keeps one post per topic explaining his member features (with the example
# pictures from guide/). Carlos edits the posts by itself on every start after they changed.
GUIDE_FORUM_ID=
