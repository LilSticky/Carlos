# Copy to .env (local) or set in the Wispbyte panel. Never commit real values.

# Discord developer portal > your application
DISCORD_TOKEN=
DISCORD_APP_ID=
# The alliance's Discord server, and the channel where members post their screenshots
GUILD_ID=
UPLOAD_CHANNEL_ID=

# The /exec link of the "Alliance upload" web app, and the same text as its BOT_SECRET script property
SHEET_URL=https://script.google.com/macros/s/.../exec
SHEET_SECRET=

# Where the SQLite file goes (default: data)
DATA_DIR=data

# Optional: the /exec links of the sheets' own web apps (Bot.js). A sheet without a link has no commands.
COACHMAN_URL=
EVENTS_URL=
KVK_URL=
STATS_URL=
